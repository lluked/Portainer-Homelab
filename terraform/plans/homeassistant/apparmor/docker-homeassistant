# AppArmor profile for the `homeassistant` container.
#
# This is Docker's own default profile (github.com/moby/profiles/apparmor,
# `baseTemplate`) plus the D-Bus permissions Home Assistant's Bluetooth
# integration needs to reach BlueZ over the host's system bus (mounted
# in via /run/dbus - see docker-compose.yml.tftpl). Docker's default
# profile ships with zero `dbus` rules, and D-Bus mediation is
# default-deny once a profile is confined at all, so bluetoothd's D-Bus
# calls (Hello/AddMatch/...) are otherwise denied outright:
#
#   apparmor="DENIED" operation="dbus_method_call" ... member="AddMatch"
#   ... name="org.freedesktop.DBus" label="docker-default"
#
# Loaded onto the host and referenced via this stack's
# `security_opt: apparmor=docker-homeassistant` instead of the default
# profile - see main.tf's null_resource.apparmor_profile.
abi <abi/3.0>,

#include <tunables/global>

profile docker-homeassistant flags=(attach_disconnected,mediate_deleted) {
  # Bus handshake (Hello/AddMatch/RemoveMatch/GetNameOwner/...) - without
  # this, even connecting to the system bus is denied.
  #include <abstractions/dbus-strict>

  # Talk to BlueZ - bluetoothd runs unconfined on this host (no AppArmor
  # profile is shipped for it), and receive its ObjectManager/property
  # signals (new/removed devices, RSSI updates, ...). Both rules are
  # scoped to peer=(name=org.bluez) specifically - not just
  # label=unconfined - so this can't be used to reach other unconfined
  # system services (logind, NetworkManager, ...) over D-Bus.
  dbus (send)
      bus=system
      peer=(name=org.bluez, label=unconfined),
  dbus (send, receive)
      bus=system
      interface=org.freedesktop.DBus.ObjectManager
      peer=(name=org.bluez, label=unconfined),

  network,
  # Disallow AF_ALG (Linux kernel crypto API); see https://copy.fail/
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  # Docker's default profile allows any capability the container holds
  # (a bare, unqualified `capability,` rule) - since AppArmor can only
  # restrict, not grant, capabilities, that's normally a no-op on top of
  # the runtime's own cap_add/cap_drop. Enumerated explicitly here
  # instead, so AppArmor is an actual second gate: Docker's standard
  # default set, plus net_admin for docker-compose.yml.tftpl's cap_add
  # (net_raw is already in the default set - listed there too anyway,
  # matching what home-assistant.io's Bluetooth docs ask for).
  capability chown,
  capability dac_override,
  capability fowner,
  capability fsetid,
  capability kill,
  capability mknod,
  capability net_admin,
  capability net_bind_service,
  capability net_raw,
  capability setfcap,
  capability setgid,
  capability setpcap,
  capability setuid,
  capability sys_chroot,
  capability audit_write,
  file,
  umount,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=docker-homeassistant,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer=docker-homeassistant,
}
