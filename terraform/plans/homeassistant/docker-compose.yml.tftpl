name: homeassistant

services:

  homeassistant:
    container_name: homeassistant
    restart: unless-stopped
    image: ghcr.io/home-assistant/home-assistant:stable
    environment:
      - DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
    devices:
      - /dev/ttyUSB0:/dev/ttyUSB0
    # Without these, the Bluetooth integration reports the adapter as
    # "operating in degraded mode": no automatic adapter recovery, and
    # management/advertising commands that need a raw HCI socket
    # (net_raw) or the management API (net_admin) fail. See
    # https://www.home-assistant.io/integrations/bluetooth/.
    cap_add:
      - NET_ADMIN
      - NET_RAW
    # Docker's default AppArmor profile denies all D-Bus traffic, which
    # blocks the Bluetooth integration's access to BlueZ - see
    # apparmor/docker-homeassistant and main.tf's
    # null_resource.apparmor_profile, which loads this profile onto the
    # host.
    security_opt:
      - apparmor=docker-homeassistant
    # Host networking is Home Assistant's own recommendation: mDNS/SSDP
    # discovery, HomeKit, DHCP-based integrations etc. rely on seeing the
    # LAN directly, which a bridge network + port mapping can't provide.
    network_mode: host
    volumes:
      - homeassistant_config:/config
      - /etc/localtime:/etc/localtime:ro
      - /run/dbus:/run/dbus:ro
    labels:
      - traefik.enable=true
    # ROUTERS
      - traefik.http.routers.homeassistant.service=homeassistant
      - traefik.http.routers.homeassistant.rule=Host(`homeassistant.${lab_domain}`)
      - traefik.http.routers.homeassistant.entrypoints=websecure
    # SERVICES
      - traefik.http.services.homeassistant.loadbalancer.server.scheme=http
      - traefik.http.services.homeassistant.loadbalancer.server.port=8123

volumes:

  homeassistant_config:
    driver: local
%{ if !docker_managed_volumes ~}
    driver_opts:
      type: none
      device: '${homeassistant_config_dir}'
      o: bind
%{ endif ~}
